pkgname=imageviewer
pkgver=2.0.0
pkgrel=1
pkgdesc="C++20 + Qt6 image viewer for Wayland/X11"
arch=('x86_64')
url='https://github.com/Fajle-Rayhan/imageviewer'
license=('MIT')
depends=('qt6-base' 'hicolor-icon-theme' 'desktop-file-utils' 'shared-mime-info')
makedepends=('cmake' 'ninja')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cmake -S "$pkgname-$pkgver" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
