[Desktop Entry]
Type=Application
Name=ImageViewer
GenericName=Image Viewer
Comment=Linux-first image viewer with thumbnails and editing overlay
Exec=imageviewer %f
Terminal=false
Categories=Graphics;Viewer;
MimeType=image/png;image/jpeg;image/webp;image/gif;image/bmp;image/svg+xml;image/tiff;
Keywords=image;viewer;hyprland;wayland;
StartupNotify=true
